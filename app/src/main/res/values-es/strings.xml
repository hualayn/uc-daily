    <string name="dm_subtitle">Consejos basados en la evidencia · Adáptalos según la fase de la enfermedad\nElabora un plan personalizado con tu médico</string>
    <string name="dm_disclaimer">📌 Nota importante\nEsta información es solo de referencia y no sustituye el consejo médico profesional.\nEl plan concreto debe elaborarse siempre con tu médico de cabecera.</string>
    <string name="dm_card_diet">Gestión de la alimentación</string>
    <string name="dm_card_lifestyle">Estilo de vida</string>
    <string name="dm_card_medical">Medicación y cuidados médicos</string>
    <string name="dm_card_psych">Bienestar psicológico</string>
    <string name="dm_card_assessment">Autoevaluación · Comparación de síntomas</string>
    <string name="dm_diet_core_principle">**Principio clave:** adáptate con flexibilidad a la **fase aguda** o a la **fase de remisión** para « aliviar » o « reparar » el intestino.</string>
    <string name="dm_diet_acute_title">🔴 Brote agudo · Reducir mucho la carga</string>
    <string name="dm_diet_acute_b1_lead">Sin residuos, líquido/semilíquido blando</string>
    <string name="dm_diet_acute_b1">Agua de arroz, fécula de loto, flan de huevo al vapor, fideos bien cocidos, caldo claro desgrasado.</string>
    <string name="dm_diet_acute_b2_lead">Objetivo</string>
    <string name="dm_diet_acute_b2">Reducir el volumen y la frecuencia de las heces para que el intestino descanse.</string>
    <string name="dm_diet_remission_title">🟢 Remisión · Reparación progresiva</string>
    <string name="dm_diet_remission_b1_lead">Rico en nutrientes, digerible, bajo en residuos</string>
    <string name="dm_diet_remission_b1">Pescado al vapor, flan de huevo, tofu tierno, carne magra finamente picada.</string>
    <string name="dm_diet_remission_b2">Aportar proteínas de calidad para reparar la mucosa intestinal.</string>
    <string name="dm_diet_issues_title">⚠️ « Alimentos problema » a los que prestar atención</string>
    <string name="dm_diet_fiber_lead">Ricos en fibra</string>
    <string name="dm_diet_fiber">(evitar durante el brote): frutos secos, semillas, maíz, palomitas, verduras crudas.</string>
    <string name="dm_diet_dairy_lead">Lácteos</string>
    <string name="dm_diet_dairy">Algunos pacientes no los toleran; puedes hacer una pausa y observar.</string>
    <string name="dm_diet_drinks_lead">Bebidas estimulantes</string>
    <string name="dm_diet_drinks">Alcohol, cafeína, bebidas carbonatadas.</string>
    <string name="dm_diet_greasy_lead">Graso, picante</string>
    <string name="dm_diet_greasy">Fritos, a la brasa, chile.</string>
    <string name="dm_diet_tips_title">💡 Consejos prácticos</string>
    <string name="dm_diet_cooking_lead">Cambia la cocción</string>
    <string name="dm_diet_cooking">Cocina frutas y verduras al vapor, hervidas, al horno o trituradas, bien hechas.</string>
    <string name="dm_diet_soluble_fiber_lead">Fibra soluble</string>
    <string name="dm_diet_soluble_fiber">(si se tolera): avena, boniato pelado, plátano, zanahoria bien cocida.</string>
    <string name="dm_diet_small_meals_lead">Comidas pequeñas y frecuentes</string>
    <string name="dm_diet_small_meals">Cinco o seis comidas pequeñas al día reducen la carga de cada una.</string>
    <string name="dm_diet_diary_lead">Diario de alimentación</string>
    <string name="dm_diet_diary">Registra alimentos y reacciones para evitar con precisión los « alimentos problema ».</string>
    <string name="dm_lifestyle_sleep_title">😴 Sueño regular</string>
    <string name="dm_lifestyle_sleep">Asegura **7~8 horas** de sueño de calidad cada noche y evita el exceso de trabajo para estabilizar tu sistema inmunitario.</string>
    <string name="dm_lifestyle_exercise_title">🚶 Ejercicio moderado</string>
    <string name="dm_lifestyle_exercise_acute_lead">Fase aguda</string>
    <string name="dm_lifestyle_exercise_acute">El descanso es prioritario; evita el ejercicio.</string>
    <string name="dm_lifestyle_exercise_remission_lead">Remisión</string>
    <string name="dm_lifestyle_exercise_remission">Ejercicio aeróbico suave (caminar, correr suave, yoga, taichí, natación). Frecuencia: **3~5 veces por semana**, 20~60 minutos, sin cansancio excesivo después.</string>
    <string name="dm_lifestyle_stress_title">🧘 Gestión del estrés</string>
    <string name="dm_lifestyle_stress">El estrés psicológico puede empeorar los síntomas; alígeralo mediante **meditación, respiración profunda, hablar con familiares y amigos o grupos de autoayuda**.</string>
    <string name="dm_med_meds_title">💊 Tomar la medicación correctamente</string>
    <string name="dm_med_meds">**Sigue estrictamente las indicaciones médicas**: nunca suspendas, reduzcas ni cambies la medicación por tu cuenta. Los fármacos habituales incluyen aminosalicilatos, inmunomoduladores y biológicos. Además, trata según la zona de la inflamación: por ejemplo, si la inflamación está en el recto, los supositorios pueden ser más eficaces.</string>
    <string name="dm_med_pain_title">🚫 Analgésicos con precaución</string>
    <string name="dm_med_pain">Evita los **antiinflamatorios no esteroideos (AINE)** (p. ej. ibuprofeno, naproxeno); pueden desencadenar un brote.</string>
    <string name="dm_med_nutrition_title">🧪 Suplementos nutricionales</string>
    <string name="dm_med_nutrition">La diarrea prolongada puede causar pérdidas nutricionales; bajo supervisión médica, complementa con **hierro, calcio y vitamina D**.</string>
    <string name="dm_med_checkup_title">📅 Revisiones periódicas</string>
    <string name="dm_med_checkup">Si la enfermedad dura **8~10 años** o más, se recomienda realizar una **colonoscopia cada 1~2 años** para vigilar la enfermedad y cribar el riesgo de cáncer.</string>
    <string name="dm_med_vaccine_title">💉 Vacunación</string>
    <string name="dm_med_vaccine">Tras consultar con tu médico, vacúnate a tiempo contra **la gripe** y **el neumococo** (la enfermedad o sus fármacos pueden afectar al sistema inmunitario).</string>
    <string name="dm_psych_p1">Reconocer que la colitis ulcerosa es una enfermedad crónica y aprender a convivir con ella es muy importante. Una actitud positiva y un buen conocimiento de la enfermedad son por sí mismos un poderoso « fármaco ».</string>
    <string name="dm_psych_tip">**🌱 Sugerencia:** si te sientes ansioso o deprimido, no dudes en buscar a tiempo la ayuda de un **profesional de la salud mental**.</string>
    <string name="dm_psych_p2">Compartir lo que sientes con la familia, los amigos u otros pacientes, y participar en grupos de apoyo, alivia la carga psicológica.</string>
    <string name="dm_assess_intro">Usa la comparación de síntomas típicos y la puntuación simple para estimar tu fase actual. ⚠️ Esta herramienta no sustituye un diagnóstico profesional; ante la duda, consulta pronto a un médico.</string>
    <string name="dm_assess_active_title">🔄 Signos frecuentes durante el brote (fase activa)</string>
    <string name="dm_assess_diarrhea_lead">Diarrea</string>
    <string name="dm_assess_diarrhea">Frecuencia de evacuaciones claramente aumentada (más de 3 veces al día), a menudo blandas o líquidas.</string>
    <string name="dm_assess_blood_lead">Sangre en las heces</string>
    <string name="dm_assess_blood">Sangre o moco en las heces, en la superficie o mezclado, a veces con coágulos o pus mucoso.</string>
    <string name="dm_assess_blood_color_lead">Color de la sangre: referencia</string>
    <string name="dm_assess_blood_color">La sangre roja viva u oscura suele indicar afectación del recto o del colon sigmoide (cerca del ano), donde la sangre se elimina rápido y se oxida poco; la sangre roja oscura o negra (alquitranada) indica una lesión más alta — colon transverso, ascendente o incluso íleon terminal — donde la sangre permanece más tiempo en el intestino y se oscurece al oxidarse. El color es solo una pista y nunca puede ser la única base para un diagnóstico.</string>
    <string name="dm_assess_pain_lead">Dolor abdominal</string>
    <string name="dm_assess_pain">Cólicos en el bajo vientre o dolor sordo continuo, que puede aliviarse tras la defecación.</string>
    <string name="dm_assess_urgency_lead">Tenesmo</string>
    <string name="dm_assess_urgency">Deseo constante de defecar con sensación de evacuación incompleta.</string>
    <string name="dm_assess_systemic_lead">Síntomas generales</string>
    <string name="dm_assess_systemic">Fiebre, cansancio, pérdida de peso, inapetencia.</string>
    <string name="dm_assess_remission_title">🟢 Signos frecuentes en remisión</string>
    <string name="dm_assess_normal_bowel_lead">Evacuaciones normales</string>
    <string name="dm_assess_normal_bowel">1~2 deposiciones formadas al día, sin sangre.</string>
    <string name="dm_assess_no_pain_lead">Dolor desaparecido</string>
    <string name="dm_assess_no_pain">Sin molestias abdominales o solo un leve dolor sordo.</string>
    <string name="dm_assess_condition_lead">Estado general</string>
    <string name="dm_assess_condition">Energía recuperada, peso estable, sin fiebre.</string>
    <string name="dm_assess_mucosa">Cicatrización de la mucosa o mejora clara en la endoscopia.</string>
    <string name="dm_assess_score_title">📝 Puntuación de actividad simple (autoevaluación)</string>
    <string name="dm_assess_score_intro">Según el promedio de los últimos 3 días, elige la opción más adecuada y toca el botón inferior para evaluar.</string>
