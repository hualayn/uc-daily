    <!-- ==================== دليل الرعاية اليومية ==================== -->
    <string name="dm_title">دليل الرعاية اليومية</string>
    <string name="dm_subtitle">نصائح مبنية على الأدلة · تكيّف بمرونة مع مرحلة المرض\nضع خطة فردية مع طبيبك</string>
    <string name="dm_disclaimer">📌 ملاحظة مهمة\nهذه المعلومات للاطلاع فقط ولا تغني عن الاستشارة الطبية المتخصصة.\nيجب دائمًا وضع الخطة المحددة مع طبيبك المعالج.</string>
    <string name="dm_card_diet">إدارة الغذاء</string>
    <string name="dm_card_lifestyle">نمط الحياة</string>
    <string name="dm_card_medical">الأدوية والرعاية الطبية</string>
    <string name="dm_card_psych">الصحة النفسية</string>
    <string name="dm_card_assessment">التقييم الذاتي · مقارنة الأعراض</string>
    <string name="dm_diet_core_principle">**المبدأ الأساسي:** تكيّف بمرونة مع **النوبة الحادة** أو **مرحلة الهدأة**، إما «بتخفيف العبء» عن الأمعاء أو «بإصلاحها».</string>
    <string name="dm_diet_acute_title">🔴 النوبة الحادة · خفّف العبء بشدة</string>
    <string name="dm_diet_acute_b1_lead">خالٍ من البقايا، سائل/نصف سائل طري</string>
    <string name="dm_diet_acute_b1">ماء الأرز، نشا اللوتس، الكاسترد المطهو على البخار، نودلز مطهو جيدًا، مرق صافٍ منزوع الدهن.</string>
    <string name="dm_diet_acute_b2_lead">الهدف</string>
    <string name="dm_diet_acute_b2">تقليل حجم البراز وعدد مرات التبرز لراحة الأمعاء.</string>
    <string name="dm_diet_remission_title">🟢 الهدأة · إصلاح تدريجي</string>
    <string name="dm_diet_remission_b1_lead">غني بالعناصر، سهل الهضم، قليل البقايا</string>
    <string name="dm_diet_remission_b1">سمك مطهو على البخار، كاسترد البيض، توفو طري، لحم خالٍ من الدهن مفروم ناعمًا.</string>
    <string name="dm_diet_remission_b2">أضف البروتين عالي الجودة لإصلاح الغشاء المخاطي للأمعاء.</string>
    <string name="dm_diet_issues_title">⚠️ «الأطعمة المسببة للمشاكل» التي يجب الانتباه إليها</string>
    <string name="dm_diet_fiber_lead">عالية الألياف</string>
    <string name="dm_diet_fiber">(تجنبها أثناء النوبة): المكسرات، البذور، الذرة، الفشار، الخضروات النيئة.</string>
    <string name="dm_diet_dairy_lead">منتجات الألبان</string>
    <string name="dm_diet_dairy">بعض المرضى لا يتحملونها؛ يمكن التوقف مؤقتًا والمراقبة.</string>
    <string name="dm_diet_drinks_lead">المشروبات المنبهة</string>
    <string name="dm_diet_drinks">الكحول والكافيين والمشروبات الغازية.</string>
    <string name="dm_diet_greasy_lead">الدهني والحار</string>
    <string name="dm_diet_greasy">المقليات والمشويات والفلفل الحار.</string>
    <string name="dm_diet_tips_title">💡 نصائح عملية</string>
    <string name="dm_diet_cooking_lead">غيّر طريقة الطهي</string>
    <string name="dm_diet_cooking">اطبخ الخضروات والفواكه بالبخار أو الغلي أو الشواء أو الخلط، حتى تنضج تمامًا.</string>
    <string name="dm_diet_soluble_fiber_lead">الألياف القابلة للذوبان</string>
    <string name="dm_diet_soluble_fiber">(عند تحملها): الشوفان، البطاطا الحلوة المقشرة، الموز، الجزر المطهو جيدًا.</string>
    <string name="dm_diet_small_meals_lead">وجبات صغيرة متكررة</string>
    <string name="dm_diet_small_meals">خمس إلى ست وجبات صغيرة يوميًا تقلل عبء كل وجبة.</string>
    <string name="dm_diet_diary_lead">مذكرات الطعام</string>
    <string name="dm_diet_diary">سجّل الأطعمة وردود الفعل لتجنب «الأطعمة المسببة للمشاكل» بدقة.</string>
    <string name="dm_lifestyle_sleep_title">😴 نوم منتظم</string>
    <string name="dm_lifestyle_sleep">احرص على **7~8 ساعات** من النوم الجيد كل ليلة وتجنب الإرهاق لاستقرار جهاز المناعة.</string>
    <string name="dm_lifestyle_exercise_title">🚶 نشاط بدني معتدل</string>
    <string name="dm_lifestyle_exercise_acute_lead">النوبة الحادة</string>
    <string name="dm_lifestyle_exercise_acute">الراحة أولًا؛ تجنب التمارين.</string>
    <string name="dm_lifestyle_exercise_remission_lead">الهدأة</string>
    <string name="dm_lifestyle_exercise_remission">تمارين هوائية خفيفة (المشي، الركض الخفيف، اليوجا، التاي تشي، السباحة). التكرار: **3~5 مرات أسبوعيًا**، من 20~60 دقيقة، دون إرهاق مفرط بعدها.</string>
    <string name="dm_lifestyle_stress_title">🧘 إدارة التوتر</string>
    <string name="dm_lifestyle_stress">يمكن أن يؤدي الضغط النفسي إلى تفاقم الأعراض؛ خفّفه عبر **التأمل، التنفس العميق، التواصل مع الأهل والأصدقاء، أو مجموعات دعم المرضى**.</string>
    <string name="dm_med_meds_title">💊 الالتزام بالدواء</string>
    <string name="dm_med_meds">**اتبع تعليمات الطبيب بدقة** — لا توقف أو تخفض أو تغيّر الدواء من تلقاء نفسك أبدًا. تشمل الأدوية الشائعة مشتقات حمض أمينوساليسيليك ومعدِّلات المناعة والأدوية البيولوجية. وعالج أيضًا حسب موقع الالتهاب: فمثلًا إذا كان الالتهاب في المستقيم، فقد تكون التحاميل أكثر فعالية.</string>
    <string name="dm_med_pain_title">🚫 استخدم مسكنات الألم بحذر</string>
    <string name="dm_med_pain">تجنب **مضادات الالتهاب غير الستيرويدية (NSAID)** (مثل الإيبوبروفين والنابروكسين)؛ فقد تحفّز نوبة المرض.</string>
    <string name="dm_med_nutrition_title">🧪 تعويض العناصر الغذائية</string>
    <string name="dm_med_nutrition">قد يؤدي الإسهال المزمن إلى فقدان العناصر الغذائية؛ بإشراف الطبيب، عوّض **الحديد والكالسيوم وفيتامين د**.</string>
    <string name="dm_med_checkup_title">📅 المتابعة المنتظمة</string>
    <string name="dm_med_checkup">لمن تجاوزت مدة المرض لديه **8~10 سنوات**، يُنصح بإجراء **تنظير القولون كل 1~2 سنة** لمراقبة الحالة وفحص خطر السرطان.</string>
    <string name="dm_med_vaccine_title">💉 التطعيم</string>
    <string name="dm_med_vaccine">بعد استشارة الطبيب، احصل في موعده على **لقاح الإنفلونزا** و**لقاح المكورات الرئوية** (لأن المرض أو أدويته قد تؤثر على جهاز المناعة).</string>
    <string name="dm_psych_p1">إدراك أن التهاب القولون التقرحي مرض مزمن وتعلّم التعايش معه أمر مهم جدًا. والعقلية الإيجابية والفهم العلمي للمرض هما بحد ذاتهما «دواء» قوي.</string>
    <string name="dm_psych_tip">**🌱 اقتراح:** إذا شعرت بالقلق أو الاكتئاب، فلا تتردد في طلب المساعدة من **أخصائي صحة نفسية** في الوقت المناسب.</string>
    <string name="dm_psych_p2">مشاركة المشاعر مع العائلة أو الأصدقاء أو مرضى آخرين، والانضمام إلى مجموعات الدعم، يخفف العبء النفسي.</string>
    <string name="dm_assess_intro">استخدم مقارنة الأعراض النمطية والدرجة البسيطة لتقدير مرحلتك الحالية تقريبًا. ⚠️ هذه الأداة لا تغني عن التشخيص المتخصص — وعند الشك، راجع الطبيب في الوقت المناسب.</string>
    <string name="dm_assess_active_title">🔄 الأعراض الشائعة أثناء النوبة (المرحلة النشطة)</string>
    <string name="dm_assess_diarrhea_lead">إسهال</string>
    <string name="dm_assess_diarrhea">زيادة ملحوظة في عدد مرات التبرز (أكثر من 3 مرات يوميًا)، غالبًا براز رخو أو مائي.</string>
    <string name="dm_assess_blood_lead">براز دموي</string>
    <string name="dm_assess_blood">دم أو مخاط في البراز، على السطح أو مختلطًا به، وأحيانًا مع جلطات أو صديد مخاطي.</string>
    <string name="dm_assess_blood_color_lead">لون الدم: مرجع</string>
    <string name="dm_assess_blood_color">الدم الأحمر الفاتح أو الداكن يشير غالبًا إلى إصابة المستقيم أو القولون السيني (القريب من فتحة الشرج)، حيث يُطرح الدم سريعًا فيتأكسد قليلًا؛ أما البراز الأحمر الداكن أو الأسود (القاري) فيشير إلى آفة أعلى — القولون المستعرض أو الصاعد أو حتى نهاية الدقاق — حيث يبقى الدم في الأمعاء مدة أطول ويتأكسد فيغمق لونه. اللون مجرد دليل مساعد ولا يجوز أبدًا الاعتماد عليه وحده للتشخيص.</string>
    <string name="dm_assess_pain_lead">ألم البطن</string>
    <string name="dm_assess_pain">مغص في أسفل البطن أو ألم خفيف مستمر، قد يخف بعد التبرز.</string>
    <string name="dm_assess_urgency_lead">زحير</string>
    <string name="dm_assess_urgency">رغبة دائمة في التبرز مع شعور بعدم الإفراغ الكامل.</string>
    <string name="dm_assess_systemic_lead">أعراض عامة</string>
    <string name="dm_assess_systemic">حُمّى، تعب، فقدان الوزن، فقدان الشهية.</string>
    <string name="dm_assess_remission_title">🟢 الأعراض الشائعة في الهدأة</string>
    <string name="dm_assess_normal_bowel_lead">تبرز طبيعي</string>
    <string name="dm_assess_normal_bowel">من 1~2 مرات تبرز متماسك يوميًا، بدون دم.</string>
    <string name="dm_assess_no_pain_lead">اختفاء الألم</string>
    <string name="dm_assess_no_pain">لا انزعاج في البطن أو ألم خفيف فقط.</string>
    <string name="dm_assess_condition_lead">الحالة العامة</string>
    <string name="dm_assess_condition">استعادة النشاط، ثبات الوزن، بدون حُمّى.</string>
    <string name="dm_assess_mucosa">شفاء الغشاء المخاطي أو تحسن ملحوظ بالمنظار.</string>
    <string name="dm_assess_score_title">📝 درجة النشاط البسيطة (مرجع للتقييم الذاتي)</string>
    <string name="dm_assess_score_intro">بناءً على متوسط آخر 3 أيام، اختر الخيار الأقرب ثم اضغط الزر أدناه للتقييم.</string>
