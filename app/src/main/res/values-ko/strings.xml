    <!-- ==================== 일상 관리 핸드북 ==================== -->
    <string name="dm_title">일상 관리 핸드북</string>
    <string name="dm_subtitle">근거 기반 권고 · 병기(病期)에 따라 유연하게 조절\n담당 의사와 함께 개인 맞춤 계획을 세우세요</string>
    <string name="dm_disclaimer">📌 중요 안내\n위 정보는 참고용이며 전문 의료 조언을 대체할 수 없습니다.\n구체적인 계획은 반드시 담당 의사와 함께 결정하세요.</string>
    <string name="dm_card_diet">식이 관리</string>
    <string name="dm_card_lifestyle">생활 습관 관리</string>
    <string name="dm_card_medical">약물과 의료 관리</string>
    <string name="dm_card_psych">심리 케어</string>
    <string name="dm_card_assessment">병세 자가 평가 · 증상 대조</string>
    <string name="dm_diet_core_principle">**핵심 원칙:** **급성기** 또는 **관해기**에 따라 유연하게 조절하여 장에 "부담을 덜거나" "회복"시킵니다.</string>
    <string name="dm_diet_acute_title">🔴 급성 발작기 · 부담을 엄격히 줄이기</string>
    <string name="dm_diet_acute_b1_lead">잔사 없음, 부드러운 유동식/반유동식</string>
    <string name="dm_diet_acute_b1">미음, 연근가루, 계란찜, 푹 익힌 국수, 기름을 뺀 맑은 국물.</string>
    <string name="dm_diet_acute_b2_lead">목적</string>
    <string name="dm_diet_acute_b2">배변량과 배변 횟수를 줄여 장을 쉬게 합니다.</string>
    <string name="dm_diet_remission_title">🟢 관해기 · 단계적 회복</string>
    <string name="dm_diet_remission_b1_lead">고영양, 소화 잘 되는, 저잔사</string>
    <string name="dm_diet_remission_b1">찜으로 익힌 생선, 계란찜, 부드러운 두부, 곱게 간 살코기.</string>
    <string name="dm_diet_remission_b2">양질의 단백질을 보충하여 장 점막을 회복시킵니다.</string>
    <string name="dm_diet_issues_title">⚠️ 주의할 "문제 음식"</string>
    <string name="dm_diet_fiber_lead">고섬유</string>
    <string name="dm_diet_fiber">(발작기에는 피하기): 견과류, 씨앗, 옥수수, 팝콘, 생채소.</string>
    <string name="dm_diet_dairy_lead">유제품</string>
    <string name="dm_diet_dairy">일부 환자는 내성이 없으므로 잠시 중단하고 관찰해 볼 수 있습니다.</string>
    <string name="dm_diet_drinks_lead">자극성 음료</string>
    <string name="dm_diet_drinks">알코올, 카페인, 탄산음료.</string>
    <string name="dm_diet_greasy_lead">기름지고 매운 음식</string>
    <string name="dm_diet_greasy">튀김, 구이, 고추.</string>
    <string name="dm_diet_tips_title">💡 실용 팁</string>
    <string name="dm_diet_cooking_lead">조리 방법 바꾸기</string>
    <string name="dm_diet_cooking">채소와 과일은 찌거나, 끓이거나, 굽거나, 갈아서 충분히 익혀 먹습니다.</string>
    <string name="dm_diet_soluble_fiber_lead">수용성 식이섬유</string>
    <string name="dm_diet_soluble_fiber">(내성이 있을 때): 오트밀, 껍질 벗긴 고구마, 바나나, 잘 익힌 당근.</string>
    <string name="dm_diet_small_meals_lead">소식(小食) 여러 번</string>
    <string name="dm_diet_small_meals">하루 5~6번 소량의 식사로 1회 부담을 줄입니다.</string>
    <string name="dm_diet_diary_lead">식사 일기</string>
    <string name="dm_diet_diary">먹은 음식과 반응을 기록해 "문제 음식"을 정확히 피합니다.</string>
    <string name="dm_lifestyle_sleep_title">😴 규칙적인 생활</string>
    <string name="dm_lifestyle_sleep">매일 밤 **7~8시간**의 질 높은 수면을 지키고 과로를 피하면 면역 체계가 안정됩니다.</string>
    <string name="dm_lifestyle_exercise_title">🚶 적절한 운동</string>
    <string name="dm_lifestyle_exercise_acute_lead">급성기</string>
    <string name="dm_lifestyle_exercise_acute">휴식을 우선하고 운동은 피합니다.</string>
    <string name="dm_lifestyle_exercise_remission_lead">관해기</string>
    <string name="dm_lifestyle_exercise_remission">가벼운 유산소 운동(산책, 조깅, 요가, 태극권, 수영). 빈도: **주 3~5회**, 1회 20~60분, 운동 후 지나친 피로를 느끼지 않는 정도로.</string>
    <string name="dm_lifestyle_stress_title">🧘 스트레스 관리</string>
    <string name="dm_lifestyle_stress">정신적 스트레스는 증상을 악화시킬 수 있습니다. **명상, 심호흡, 가족·친구와의 대화, 환우 상호 도움 모임** 등으로 풀어내세요.</string>
    <string name="dm_med_meds_title">💊 올바른 복약</string>
    <string name="dm_med_meds">**의사의 지시를 엄격히 따르고** 스스로 약을 끊거나 줄이거나 바꾸지 마세요. 흔히 쓰는 약으로는 아미노살리실산계, 면역 조절제, 생물학적 제제 등이 있습니다. 또한 염증이 생긴 부위에 따라 맞는 약을 씁니다. 예를 들어 염증이 직장에 있다면 좌약이 더 효과적일 수 있습니다.</string>
    <string name="dm_med_pain_title">🚫 진통제는 신중하게</string>
    <string name="dm_med_pain">**비스테로이드성 소염진통제(NSAID)**(이부프로펜, 나프록센 등)는 피하세요. 발작을 유발할 수 있습니다.</string>
    <string name="dm_med_nutrition_title">🧪 영양소 보충</string>
    <string name="dm_med_nutrition">오래 지속되는 설사는 영양 손실로 이어질 수 있습니다. 의사 지도 아래 **철분, 칼슘, 비타민 D**를 보충하세요.</string>
    <string name="dm_med_checkup_title">📅 정기 검진</string>
    <string name="dm_med_checkup">유병 기간 **8~10년** 이상이면 의사의 지시에 따라 **1~2년마다** 대장내시경 검사를 받아 병세를 관찰하고 암 위험을 선별할 것을 권장합니다.</string>
    <string name="dm_med_vaccine_title">💉 예방접종</string>
    <string name="dm_med_vaccine">의사와 상담한 뒤 **독감 백신**과 **폐렴구균 백신**을 제때 접종하세요(질환이나 약물이 면역 체계에 영향을 줄 수 있기 때문입니다).</string>
    <string name="dm_psych_p1">궤양성 대장염이 만성 질환이라는 것을 인식하고, 그것과 공존하는 법을 배우는 것은 매우 중요합니다. 긍정적인 마음과 과학적인 질병 인식 그 자체가 강력한 "약"입니다.</string>
    <string name="dm_psych_tip">**🌱 제안:** 불안하거나 우울하다고 느껴지면 망설이지 말고 **전문 심리 상담사**의 도움을 제때 받으세요.</string>
    <string name="dm_psych_p2">가족, 친구, 환우와 마음을 나누고 지원 모임에 참여하면 심리적 부담을 덜 수 있습니다.</string>
    <string name="dm_assess_intro">전형적인 증상 대조와 간이 점수로 현재 단계를 대략적으로 판단합니다. ⚠️ 이 도구는 전문 진단을 대체할 수 없으며, 의심되면 빨리 진료를 받으세요.</string>
    <string name="dm_assess_active_title">🔄 발작기(활동기)의 흔한 증상</string>
    <string name="dm_assess_diarrhea_lead">설사</string>
    <string name="dm_assess_diarrhea">배변 횟수가 뚜렷이 늘어나고(하루 3회 이상) 묽은 변이나 수양변인 경우가 많습니다.</string>
    <string name="dm_assess_blood_lead">혈변</string>
    <string name="dm_assess_blood">변에 혈액이나 점액이 섞여 표면에 붙거나 변과 혼합되며, 때로 혈괴나 점액 화농성 물질이 동반됩니다.</string>
    <string name="dm_assess_blood_color_lead">혈변 색깔 참고</string>
    <string name="dm_assess_blood_color">선홍색이나 짙은 붉은색은 직장이나 구불결장(항문에 가까움)의 병변을 시사하는 경우가 많고, 혈액이 빨리 배출되어 산화가 적기 때문입니다. 짙은 붉은색이나 검은색(타르색) 변은 횡행결장, 상행결장, 심지어 회장 말단부처럼 높은 위치의 병변을 시사하며, 혈액이 장에 오래 머물며 산화되어 색이 짙어집니다. 색깔은 어디까지나 판단의 한 단서이며, 확진이나 자가 진단의 유일한 근거가 될 수 없습니다.</string>
    <string name="dm_assess_pain_lead">복통</string>
    <string name="dm_assess_pain">하복부의 산통(쥐어짜는 통증)이나 지속적인 둔통으로, 배변 후 가벼워질 수 있습니다.</string>
    <string name="dm_assess_urgency_lead">후중감</string>
    <string name="dm_assess_urgency">항상 변의가 있지만 시원하게 다 비워지지 않는 느낌입니다.</string>
    <string name="dm_assess_systemic_lead">전신 증상</string>
    <string name="dm_assess_systemic">발열, 무기력, 체중 감소, 식욕 부진.</string>
    <string name="dm_assess_remission_title">🟢 관해기의 흔한 증상</string>
    <string name="dm_assess_normal_bowel_lead">배변이 정상</string>
    <string name="dm_assess_normal_bowel">하루 1~2회의 성형변, 혈변 없음.</string>
    <string name="dm_assess_no_pain_lead">복통 소실</string>
    <string name="dm_assess_no_pain">복부에 불편감이 없거나 가벼운 둔통만 있습니다.</string>
    <string name="dm_assess_condition_lead">전신 상태</string>
    <string name="dm_assess_condition">기력 회복, 체중 안정, 발열 없음.</string>
    <string name="dm_assess_mucosa">내시경 검사에서 점막 치유 또는 뚜렷한 개선.</string>
    <string name="dm_assess_score_title">📝 간이 활동성 점수 (자가 평가 참고)</string>
    <string name="dm_assess_score_intro">최근 3일의 평균 상태를 기준으로 가장 가까운 항목을 선택하고 아래 버튼을 눌러 평가하세요.</string>
    <string name="dm_assess_q1">1. 하루 배변 횟수</string>
    <string name="dm_assess_q2">2. 혈변 상태</string>
    <string name="dm_assess_q3">3. 복통 정도</string>
    <string name="dm_assess_q4">4. 체온 (겨드랑이)</string>
    <string name="dm_assess_opt_freq_0">3회 미만 (0점)</string>
    <string name="dm_assess_opt_freq_1">3~5회 (1점)</string>
