    <!-- ==================== Manuel de soins quotidiens ==================== -->
    <string name="dm_title">Manuel de soins quotidiens</string>
    <string name="dm_subtitle">Conseils fondés sur les données probantes · À ajuster selon la phase de la maladie\nÉlaborez un plan personnalisé avec votre médecin</string>
    <string name="dm_disclaimer">📌 Note importante\nCes informations sont fournies à titre de référence et ne remplacent pas un avis médical professionnel.\nÉlaborez toujours votre plan avec votre médecin traitant.</string>
    <string name="dm_card_diet">Alimentation</string>
    <string name="dm_card_lifestyle">Mode de vie</string>
    <string name="dm_card_medical">Médicaments et soins médicaux</string>
    <string name="dm_card_psych">Bien-être psychologique</string>
    <string name="dm_card_assessment">Auto-évaluation · Comparaison des symptômes</string>
    <string name="dm_diet_core_principle">**Principe clé :** ajustez-vous selon la **phase aiguë** ou la **phase de rémission** pour « soulager » ou « réparer » votre intestin.</string>
    <string name="dm_diet_acute_title">🔴 Poussée aiguë · Réduire fortement la charge</string>
    <string name="dm_diet_acute_b1_lead">Sans résidu, liquide/semi-liquide mou</string>
    <string name="dm_diet_acute_b1">Eau de riz, fécule de lotus, œuf vapeur, nouilles bien cuites, bouillon clair dégraissé.</string>
    <string name="dm_diet_acute_b2_lead">Objectif</string>
    <string name="dm_diet_acute_b2">Réduire le volume et la fréquence des selles pour laisser l\'intestin se reposer.</string>
    <string name="dm_diet_remission_title">🟢 Rémission · Réparation progressive</string>
    <string name="dm_diet_remission_b1_lead">Riche en nutriments, digeste, pauvre en résidus</string>
    <string name="dm_diet_remission_b1">Poisson vapeur, œuf vapeur, tofu tendre, viande maigre finement hachée.</string>
    <string name="dm_diet_remission_b2">Apportez des protéines de qualité pour réparer la muqueuse intestinale.</string>
    <string name="dm_diet_issues_title">⚠️ Aliments « à problème » à surveiller</string>
    <string name="dm_diet_fiber_lead">Fibres</string>
    <string name="dm_diet_fiber">(à éviter en poussée) : noix, graines, maïs, pop-corn, légumes crus.</string>
    <string name="dm_diet_dairy_lead">Produits laitiers</string>
    <string name="dm_diet_dairy">Certains patients ne les tolèrent pas ; vous pouvez faire une pause et observer.</string>
    <string name="dm_diet_drinks_lead">Boissons stimulantes</string>
    <string name="dm_diet_drinks">Alcool, caféine, boissons gazeuses.</string>
    <string name="dm_diet_greasy_lead">Gras, épicé</string>
    <string name="dm_diet_greasy">Fritures, grillades, piment.</string>
    <string name="dm_diet_tips_title">💡 Conseils pratiques</string>
    <string name="dm_diet_cooking_lead">Changez la cuisson</string>
    <string name="dm_diet_cooking">Faites cuire les fruits et légumes à la vapeur, à l\'eau, au four ou mixés, bien cuits.</string>
    <string name="dm_diet_soluble_fiber_lead">Fibres solubles</string>
    <string name="dm_diet_soluble_fiber">(si toléré) : avoine, patate douce pelée, banane, carotte bien cuite.</string>
    <string name="dm_diet_small_meals_lead">Petits repas fréquents</string>
    <string name="dm_diet_small_meals">Cinq à six petits repas par jour réduisent la charge de chaque repas.</string>
    <string name="dm_diet_diary_lead">Journal alimentaire</string>
    <string name="dm_diet_diary">Notez aliments et réactions pour éviter précisément les « aliments à problème ».</string>
    <string name="dm_lifestyle_sleep_title">😴 Sommeil régulier</string>
    <string name="dm_lifestyle_sleep">Assurez **7~8 heures** de sommeil de qualité chaque nuit et évitez le surmenage pour stabiliser votre système immunitaire.</string>
    <string name="dm_lifestyle_exercise_title">🚶 Activité physique modérée</string>
    <string name="dm_lifestyle_exercise_acute_lead">Phase aiguë</string>
    <string name="dm_lifestyle_exercise_acute">Le repos prime ; évitez l\'exercice.</string>
    <string name="dm_lifestyle_exercise_remission_lead">Rémission</string>
    <string name="dm_lifestyle_exercise_remission">Aérobie douce (marche, jogging, yoga, taï-chi, natation). Fréquence : **3~5 fois par semaine**, 20~60 minutes, sans fatigue excessive après l\'effort.</string>
    <string name="dm_lifestyle_stress_title">🧘 Gestion du stress</string>
    <string name="dm_lifestyle_stress">Le stress psychologique peut aggraver les symptômes ; soulagez-le par **la méditation, la respiration profonde, les échanges avec vos proches ou des groupes d\'entraide**.</string>
    <string name="dm_med_meds_title">💊 Prendre ses médicaments correctement</string>
    <string name="dm_med_meds">**Suivez strictement les prescriptions** — ne stoppez, ne réduisez et ne changez jamais un traitement seul(e). Les médicaments courants incluent les aminosalicylés, les immunomodulateurs et les biothérapies. Adaptez aussi le traitement à la localisation de l\'inflammation : par exemple, si l\'inflammation touche le rectum, des suppositoires peuvent être plus efficaces.</string>
    <string name="dm_med_pain_title">🚫 Antidouleurs avec prudence</string>
    <string name="dm_med_pain">Évitez les **anti-inflammatoires non stéroïdiens (AINS)** (ibuprofène, naproxène, etc.) — ils peuvent déclencher une poussée.</string>
    <string name="dm_med_nutrition_title">🧪 Compléments nutritionnels</string>
    <string name="dm_med_nutrition">Une diarrhée prolongée peut entraîner des pertes nutritionnelles ; sous avis médical, complétez en **fer, calcium et vitamine D**.</string>
    <string name="dm_med_checkup_title">📅 Suivi régulier</string>
    <string name="dm_med_checkup">Si la maladie dure depuis **8~10 ans** ou plus, il est recommandé de réaliser **une coloscopie tous les 1~2 ans** pour surveiller la maladie et dépister un risque de cancer.</string>
    <string name="dm_med_vaccine_title">💉 Vaccination</string>
    <string name="dm_med_vaccine">Après avis de votre médecin, faites-vous vacciner à temps contre la **grippe** et le **pneumocoque** (la maladie ou ses traitements peuvent affecter le système immunitaire).</string>
    <string name="dm_psych_p1">Reconnaître que la rectocolite hémorragique est une maladie chronique et apprendre à vivre avec est très important. Un état d\'esprit positif et une bonne compréhension de la maladie sont eux-mêmes un puissant « médicament ».</string>
    <string name="dm_psych_tip">**🌱 Suggestion :** si vous ressentez de l\'anxiété ou une déprime, n\'hésitez pas à consulter rapidement un **professionnel de santé mentale**.</string>
    <string name="dm_psych_p2">Partager son vécu avec sa famille, ses amis ou d\'autres patients, et participer à des groupes de soutien, allège le fardeau psychologique.</string>
    <string name="dm_assess_intro">Utilisez la comparaison des symptômes typiques et le score simple pour estimer votre phase actuelle. ⚠️ Cet outil ne remplace pas un diagnostic professionnel — en cas de doute, consultez rapidement.</string>
    <string name="dm_assess_active_title">🔄 Signes fréquents en poussée (phase active)</string>
    <string name="dm_assess_diarrhea_lead">Diarrhée</string>
    <string name="dm_assess_diarrhea">Fréquence des selles nettement augmentée (plus de 3 fois/jour), souvent liquides ou molles.</string>
    <string name="dm_assess_blood_lead">Sang dans les selles</string>
    <string name="dm_assess_blood">Sang ou glaires dans les selles, en surface ou mélangés, parfois avec caillots ou pus glaireux.</string>
    <string name="dm_assess_blood_color_lead">Couleur du sang : référence</string>
    <string name="dm_assess_blood_color">Un sang rouge vif ou rouge foncé évoque souvent une atteinte du rectum ou du côlon sigmoïde (près de l\'anus), le sang étant éliminé vite et peu oxydé ; un sang rouge sombre ou noir (goudron) évoque une lésion plus haute — côlon transverse, ascendant, voire iléon terminal — où le sang reste longtemps dans l\'intestin et s\'assombrit après oxydation. La couleur n\'est qu\'un indice d\'orientation, jamais l\'unique base d\'un diagnostic personnel.</string>
    <string name="dm_assess_pain_lead">Douleur abdominale</string>
    <string name="dm_assess_pain">Crampes du bas-ventre ou douleur sourde continue, parfois atténuée après la selle.</string>
    <string name="dm_assess_urgency_lead">Ténesme</string>
    <string name="dm_assess_urgency">Envie constante d\'aller à la selle mais sensation d\'évacuation incomplète.</string>
    <string name="dm_assess_systemic_lead">Symptômes généraux</string>
    <string name="dm_assess_systemic">Fièvre, fatigue, perte de poids, perte d\'appétit.</string>
    <string name="dm_assess_remission_title">🟢 Signes fréquents en rémission</string>
    <string name="dm_assess_normal_bowel_lead">Selles normales</string>
    <string name="dm_assess_normal_bowel">1~2 selles moulées par jour, sans sang.</string>
    <string name="dm_assess_no_pain_lead">Douleur disparue</string>
    <string name="dm_assess_no_pain">Pas d\'inconfort abdominal, ou une légère douleur sourde.</string>
    <string name="dm_assess_condition_lead">État général</string>
    <string name="dm_assess_condition">Énergie retrouvée, poids stable, pas de fièvre.</string>
    <string name="dm_assess_mucosa">Cicatrisation muqueuse ou amélioration nette en endoscopie.</string>
    <string name="dm_assess_score_title">📝 Score d\'activité simple (référence d\'auto-évaluation)</string>
    <string name="dm_assess_score_intro">Sur la base de la moyenne des 3 derniers jours, choisissez l\'option la plus proche, puis touchez le bouton ci-dessous pour évaluer.</string>
    <string name="dm_assess_q1">1. Selles par jour</string>
    <string name="dm_assess_q2">2. Saignement</string>
    <string name="dm_assess_q3">3. Douleur abdominale</string>
    <string name="dm_assess_q4">4. Température (axillaire)</string>
