    <!-- ==================== 日常管理手册 ==================== -->
    <string name="dm_title">日常管理手册</string>
    <string name="dm_subtitle">基于循证建议 · 根据病情阶段灵活调整\n与你的医生共同制定个体化方案</string>
    <string name="dm_disclaimer">📌 重要提示\n以上信息仅供参考，不能替代专业医疗建议。\n具体方案请务必与你的主治医生共同制定。</string>
    <string name="dm_card_diet">饮食管理</string>
    <string name="dm_card_lifestyle">生活方式管理</string>
    <string name="dm_card_medical">药物与医疗管理</string>
    <string name="dm_card_psych">心理调适</string>
    <string name="dm_card_assessment">病情自评 · 症状对照</string>
    <string name="dm_diet_core_principle">**核心原则：**根据 **急性期** 或 **缓解期** 灵活调整，给肠道“减负”或“修复”。</string>
    <string name="dm_diet_acute_title">🔴 急性发作期 · 严格减负</string>
    <string name="dm_diet_acute_b1_lead">无渣、软烂流质/半流质</string>
    <string name="dm_diet_acute_b1">米汤、藕粉、蒸蛋羹、烂面条、去油清汤。</string>
    <string name="dm_diet_acute_b2_lead">目的</string>
    <string name="dm_diet_acute_b2">减少粪便体积和排便次数，让肠道休息。</string>
    <string name="dm_diet_remission_title">🟢 缓解期 · 逐步修复</string>
    <string name="dm_diet_remission_b1_lead">高营养、易消化、低渣</string>
    <string name="dm_diet_remission_b1">清蒸鱼、鸡蛋羹、嫩豆腐、瘦肉糜。</string>
    <string name="dm_diet_remission_b2">补充优质蛋白，修复肠黏膜。</string>
    <string name="dm_diet_issues_title">⚠️ 需要留意的“问题食物”</string>
    <string name="dm_diet_fiber_lead">高纤维</string>
    <string name="dm_diet_fiber">（发作期避免）：坚果、种子、玉米、爆米花、生蔬菜。</string>
    <string name="dm_diet_dairy_lead">乳制品</string>
    <string name="dm_diet_dairy">部分患者不耐受，可暂停观察。</string>
    <string name="dm_diet_drinks_lead">刺激性饮品</string>
    <string name="dm_diet_drinks">酒精、咖啡因、碳酸饮料。</string>
    <string name="dm_diet_greasy_lead">油腻、辛辣</string>
    <string name="dm_diet_greasy">油炸、烧烤、辣椒。</string>
    <string name="dm_diet_tips_title">💡 实用技巧</string>
    <string name="dm_diet_cooking_lead">改变烹饪</string>
    <string name="dm_diet_cooking">蔬菜水果蒸、煮、烤、搅拌，做熟做烂。</string>
    <string name="dm_diet_soluble_fiber_lead">可溶性纤维</string>
    <string name="dm_diet_soluble_fiber">（耐受时）：燕麦、去皮红薯、香蕉、熟胡萝卜。</string>
    <string name="dm_diet_small_meals_lead">少食多餐</string>
    <string name="dm_diet_small_meals">一日五到六顿小餐，减轻单次负担。</string>
    <string name="dm_diet_diary_lead">饮食日记</string>
    <string name="dm_diet_diary">记录食物与反应，精准避开“问题食物”。</string>
    <string name="dm_lifestyle_sleep_title">😴 规律作息</string>
    <string name="dm_lifestyle_sleep">保证 **每晚 7~8 小时** 高质量睡眠，避免过度劳累，有助于免疫系统稳定。</string>
    <string name="dm_lifestyle_exercise_title">🚶 适度运动</string>
    <string name="dm_lifestyle_exercise_acute_lead">急性期</string>
    <string name="dm_lifestyle_exercise_acute">以休息为主，避免运动。</string>
    <string name="dm_lifestyle_exercise_remission_lead">缓解期</string>
    <string name="dm_lifestyle_exercise_remission">温和有氧（散步、慢跑、瑜伽、太极、游泳）。频率：**每周 3~5 次**，每次 20~60 分钟，以运动后不感到过度疲劳为宜。</string>
    <string name="dm_lifestyle_stress_title">🧘 压力管理</string>
    <string name="dm_lifestyle_stress">精神压力会加重症状，可通过 **冥想、深呼吸、与亲友交流、病友互助小组** 等方式排解。</string>
    <string name="dm_med_meds_title">💊 规范用药</string>
    <string name="dm_med_meds">**严格遵医嘱**，切勿自行停药、减量或换药。常用药物包括氨基水杨酸类、免疫调节剂、生物制剂等。另外，根据炎症发生的部位，对症用药。比如，炎症发生在直肠段，那么使用栓剂能够达到更好的疗效。</string>
    <string name="dm_med_pain_title">🚫 谨慎使用止痛药</string>
    <string name="dm_med_pain">避免 **非甾体类抗炎药（NSAID）**（如布洛芬、萘普生），可能诱发疾病发作。</string>
    <string name="dm_med_nutrition_title">🧪 补充营养素</string>
    <string name="dm_med_nutrition">长期腹泻可能导致营养流失，可在医生指导下补充 **铁、钙和维生素 D**。</string>
    <string name="dm_med_checkup_title">📅 定期复查</string>
    <string name="dm_med_checkup">患病 **8~10 年** 以上者，建议遵医嘱 **每 1~2 年** 接受结肠镜检查，监测病情及筛查癌变风险。</string>
    <string name="dm_med_vaccine_title">💉 接种疫苗</string>
    <string name="dm_med_vaccine">咨询医生后，按时接种 **流感疫苗** 和 **肺炎球菌疫苗**（因疾病或药物可能影响免疫系统）。</string>
    <string name="dm_psych_p1">认识到溃疡性结肠炎是一种慢性病，学会与它共存非常重要。积极的心态和科学的疾病认知，本身就是一种强大的“药物”。</string>
    <string name="dm_psych_tip">**🌱 建议：** 如果感到焦虑或抑郁，不要犹豫，及时寻求 **专业心理咨询师** 的帮助。</string>
    <string name="dm_psych_p2">与家人、朋友或病友分享感受，参与支持团体，有助于减轻心理负担。</string>
    <string name="dm_assess_intro">通过典型症状对照和简易评分，初步判断当前所处阶段。⚠️ 本工具不能替代专业诊断，如有疑虑请及时就医。</string>
    <string name="dm_assess_active_title">🔄 发作期（活动期）常见表现</string>
    <string name="dm_assess_diarrhea_lead">腹泻</string>
    <string name="dm_assess_diarrhea">排便次数显著增多（每日 > 3次），常为稀便或水样便。</string>
    <string name="dm_assess_blood_lead">便血</string>
    <string name="dm_assess_blood">粪便中带血或黏液，可附着在粪便表面或与粪便混合，有时伴血块或黏液脓液。</string>
    <string name="dm_assess_blood_color_lead">血便颜色参考</string>
    <string name="dm_assess_blood_color">鲜红色或暗红色多提示病变在直肠或乙状结肠（靠近肛门），血液排出快、较少被氧化；暗红色或黑色（柏油样）便多提示病变位置较高，如横结肠、升结肠甚至回肠末端，血液在肠道停留久、被氧化后颜色变深。颜色只是辅助判断的线索之一，绝不能作为确诊或自我诊断的唯一依据。</string>
    <string name="dm_assess_pain_lead">腹痛</string>
    <string name="dm_assess_pain">下腹部绞痛或持续性钝痛，排便后可能减轻。</string>
    <string name="dm_assess_urgency_lead">里急后重</string>
    <string name="dm_assess_urgency">总有便意，但排便不尽感。</string>
    <string name="dm_assess_systemic_lead">全身症状</string>
    <string name="dm_assess_systemic">发热、乏力、体重下降、食欲不振。</string>
    <string name="dm_assess_remission_title">🟢 缓解期常见表现</string>
    <string name="dm_assess_normal_bowel_lead">排便正常</string>
    <string name="dm_assess_normal_bowel">每日 1~2 次成形便，无血便。</string>
    <string name="dm_assess_no_pain_lead">腹痛消失</string>
    <string name="dm_assess_no_pain">腹部无不适或仅有轻微隐痛。</string>
    <string name="dm_assess_condition_lead">全身状态</string>
    <string name="dm_assess_condition">精力恢复，体重稳定，无发热。</string>
    <string name="dm_assess_mucosa">内镜下黏膜愈合或显著改善。</string>
    <string name="dm_assess_score_title">📝 简易活动性评分（自评参考）</string>
    <string name="dm_assess_score_intro">请根据近3天的平均情况，选择最符合的选项，点击下方按钮评估。</string>
