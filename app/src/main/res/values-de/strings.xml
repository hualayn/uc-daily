    <!-- ==================== Handbuch zur Alltagspflege ==================== -->
    <string name="dm_title">Handbuch zur Alltagspflege</string>
    <string name="dm_subtitle">Evidenzbasierte Hinweise · Flexibel an die Krankheitsphase anpassen\nErstellen Sie einen individuellen Plan mit Ihrem Arzt</string>
    <string name="dm_disclaimer">📌 Wichtiger Hinweis\nDiese Informationen dienen nur der Orientierung und ersetzen keine professionelle medizinische Beratung.\nDen konkreten Plan sollten Sie unbedingt mit Ihrem behandelnden Arzt erstellen.</string>
    <string name="dm_card_diet">Ernährungsmanagement</string>
    <string name="dm_card_lifestyle">Lebensstil</string>
    <string name="dm_card_medical">Medikamente &amp; medizinische Versorgung</string>
    <string name="dm_card_psych">Psychisches Wohlbefinden</string>
    <string name="dm_card_assessment">Selbstbeurteilung · Symptom-Vergleich</string>
    <string name="dm_diet_core_principle">**Kernprinzip:** Passen Sie sich flexibel an die **akute Phase** oder die **Remissionsphase** an, um den Darm zu „entlasten“ oder zu „reparieren“.</string>
    <string name="dm_diet_acute_title">🔴 Akuter Schub · Belastung strikt reduzieren</string>
    <string name="dm_diet_acute_b1_lead">Rückstandsarm, weich, flüssig/halbfest</string>
    <string name="dm_diet_acute_b1">Reiswasser, Lotoswurzelstärke, gedämpfter Eierstich, weich gekochte Nudeln, entfettete klare Brühe.</string>
    <string name="dm_diet_acute_b2_lead">Zweck</string>
    <string name="dm_diet_acute_b2">Stuhlmenge und -häufigkeit reduzieren, damit der Darm ruhen kann.</string>
    <string name="dm_diet_remission_title">🟢 Remission · Schrittweise Reparatur</string>
    <string name="dm_diet_remission_b1_lead">Nährstoffreich, leicht verdaulich, rückstandsarm</string>
    <string name="dm_diet_remission_b1">Gedämpfter Fisch, Eierstich, weicher Tofu, fein gehacktes mageres Fleisch.</string>
    <string name="dm_diet_remission_b2">Hochwertiges Eiweiß zuführen, um die Darmschleimhaut zu reparieren.</string>
    <string name="dm_diet_issues_title">⚠️ „Problem-Lebensmittel“, auf die Sie achten sollten</string>
    <string name="dm_diet_fiber_lead">Ballaststoffreich</string>
    <string name="dm_diet_fiber">(im Schub vermeiden): Nüsse, Samen, Mais, Popcorn, rohes Gemüse.</string>
    <string name="dm_diet_dairy_lead">Milchprodukte</string>
    <string name="dm_diet_dairy">Manche Patienten vertragen sie nicht; Sie können pausieren und beobachten.</string>
    <string name="dm_diet_drinks_lead">Stimulierende Getränke</string>
    <string name="dm_diet_drinks">Alkohol, Koffein, kohlensäurehaltige Getränke.</string>
    <string name="dm_diet_greasy_lead">Fettig, scharf</string>
    <string name="dm_diet_greasy">Frittiertes, Gegrilltes, Chili.</string>
    <string name="dm_diet_tips_title">💡 Praktische Tipps</string>
    <string name="dm_diet_cooking_lead">Zubereitung ändern</string>
    <string name="dm_diet_cooking">Gemüse und Obst dämpfen, kochen, backen oder pürieren – gut durchgaren.</string>
    <string name="dm_diet_soluble_fiber_lead">Lösliche Ballaststoffe</string>
    <string name="dm_diet_soluble_fiber">(wenn verträglich): Haferflocken, geschälte Süßkartoffel, Banane, gut gekochte Karotte.</string>
    <string name="dm_diet_small_meals_lead">Kleine, häufige Mahlzeiten</string>
    <string name="dm_diet_small_meals">Fünf bis sechs kleine Mahlzeiten am Tag reduzieren die Belastung pro Mahlzeit.</string>
    <string name="dm_diet_diary_lead">Ernährungstagebuch</string>
    <string name="dm_diet_diary">Notieren Sie Lebensmittel und Reaktionen, um „Problem-Lebensmittel“ gezielt zu vermeiden.</string>
    <string name="dm_lifestyle_sleep_title">😴 Regelmäßiger Schlaf</string>
    <string name="dm_lifestyle_sleep">Sorgen Sie für **7~8 Stunden** guten Schlaf pro Nacht und vermeiden Sie Überanstrengung, um Ihr Immunsystem zu stabilisieren.</string>
    <string name="dm_lifestyle_exercise_title">🚶 Moderate Bewegung</string>
    <string name="dm_lifestyle_exercise_acute_lead">Akute Phase</string>
    <string name="dm_lifestyle_exercise_acute">Ruhe hat Vorrang; Bewegung vermeiden.</string>
    <string name="dm_lifestyle_exercise_remission_lead">Remission</string>
    <string name="dm_lifestyle_exercise_remission">Sanftes Ausdauertraining (Gehen, Joggen, Yoga, Tai-Chi, Schwimmen). Häufigkeit: **3~5 Mal pro Woche**, je 20~60 Minuten, ohne übermäßige Erschöpfung danach.</string>
    <string name="dm_lifestyle_stress_title">🧘 Stressmanagement</string>
    <string name="dm_lifestyle_stress">Psychischer Stress kann Symptome verschlimmern; bauen Sie ihn ab durch **Meditation, tiefes Atmen, Gespräche mit Angehörigen oder Selbsthilfegruppen**.</string>
    <string name="dm_med_meds_title">💊 Medikamente richtig einnehmen</string>
    <string name="dm_med_meds">**Folgen Sie strikt den ärztlichen Anweisungen** – stellen, reduzieren oder wechseln Sie Medikamente nie eigenmächtig ab. Übliche Medikamente sind Aminosalicylate, Immunmodulatoren und Biologika. Behandeln Sie außerdem je nach Entzündungsort: Bei Entzündung im Mastdarm können Zäpfchen wirksamer sein.</string>
    <string name="dm_med_pain_title">🚫 Schmerzmittel mit Vorsicht</string>
    <string name="dm_med_pain">Vermeiden Sie **nichtsteroidale Antirheumatika (NSAR)** (z. B. Ibuprofen, Naproxen) – sie können einen Schub auslösen.</string>
    <string name="dm_med_nutrition_title">🧪 Nährstoffergänzung</string>
    <string name="dm_med_nutrition">Längerer Durchfall kann zu Nährstoffverlust führen; ergänzen Sie unter ärztlicher Anleitung **Eisen, Kalzium und Vitamin D**.</string>
    <string name="dm_med_checkup_title">📅 Regelmäßige Kontrolle</string>
    <string name="dm_med_checkup">Bei einer Krankheitsdauer von **8~10 Jahren** oder mehr wird empfohlen, **alle 1~2 Jahre** eine Darmspiegelung (Koloskopie) durchführen zu lassen, um den Verlauf zu überwachen und das Krebsrisiko zu prüfen.</string>
    <string name="dm_med_vaccine_title">💉 Impfungen</string>
    <string name="dm_med_vaccine">Lassen Sie sich nach Rücksprache mit Ihrem Arzt rechtzeitig gegen **Grippe** und **Pneumokokken** impfen (Krankheit oder Medikamente können das Immunsystem beeinflussen).</string>
    <string name="dm_psych_p1">Zu erkennen, dass Colitis ulcerosa eine chronische Erkrankung ist, und zu lernen, mit ihr zu leben, ist sehr wichtig. Eine positive Einstellung und ein fundiertes Verständnis der Krankheit sind selbst ein starkes „Medikament“.</string>
    <string name="dm_psych_tip">**🌱 Empfehlung:** Wenn Sie sich ängstlich oder niedergeschlagen fühlen, zögern Sie nicht und suchen Sie rechtzeitig Hilfe bei einem **professionellen Psychologen**.</string>
    <string name="dm_psych_p2">Gefühle mit Familie, Freunden oder Mitbetroffenen zu teilen und Selbsthilfegruppen beizutreten, entlastet die Psyche.</string>
    <string name="dm_assess_intro">Nutzen Sie den typischen Symptomvergleich und den einfachen Score, um Ihre derzeitige Phase grob einzuschätzen. ⚠️ Dieses Tool ersetzt keine fachliche Diagnose – bei Zweifeln suchen Sie rechtzeitig einen Arzt auf.</string>
    <string name="dm_assess_active_title">🔄 Häufige Zeichen im Schub (aktive Phase)</string>
    <string name="dm_assess_diarrhea_lead">Durchfall</string>
    <string name="dm_assess_diarrhea">Deutlich erhöhte Stuhlfrequenz (mehr als 3×/Tag), oft weich oder wässrig.</string>
    <string name="dm_assess_blood_lead">Blut im Stuhl</string>
    <string name="dm_assess_blood">Blut oder Schleim im Stuhl, an der Oberfläche oder darin gemischt, manchmal mit Gerinnseln oder schleimig-eitrigem Ausfluss.</string>
    <string name="dm_assess_blood_color_lead">Farbe des Blutes: Referenz</string>
    <string name="dm_assess_blood_color">Helles oder dunkles Rot deutet oft auf eine Beteiligung von Rektum oder Sigmoid (nahe am After) hin – das Blut wird schnell ausgeschieden und ist wenig oxidiert; dunkelroter oder schwarzer (teerartiger) Stuhl deutet auf eine höher gelegene Läsion hin, etwa Querkolon, aufsteigendes Kolon oder terminales Ileum – das Blut verweilt länger im Darm und wird durch Oxidation dunkler. Die Farbe ist nur ein Hinweis und niemals die alleinige Grundlage einer Diagnose.</string>
    <string name="dm_assess_pain_lead">Bauchschmerzen</string>
    <string name="dm_assess_pain">Krampfartige oder anhaltend dumpfe Schmerzen im Unterbauch, nach dem Stuhlgang oft besser.</string>
    <string name="dm_assess_urgency_lead">Stuhldrang (Tenesmen)</string>
    <string name="dm_assess_urgency">Ständiger Stuhldrang mit dem Gefühl unvollständiger Entleerung.</string>
    <string name="dm_assess_systemic_lead">Allgemeinsymptome</string>
    <string name="dm_assess_systemic">Fieber, Müdigkeit, Gewichtsverlust, Appetitlosigkeit.</string>
    <string name="dm_assess_remission_title">🟢 Häufige Zeichen in der Remission</string>
    <string name="dm_assess_normal_bowel_lead">Normaler Stuhlgang</string>
    <string name="dm_assess_normal_bowel">1~2 geformte Stühle täglich, ohne Blut.</string>
    <string name="dm_assess_no_pain_lead">Schmerzfrei</string>
    <string name="dm_assess_no_pain">Kein Bauchunbehagen oder nur leichter dumpfer Schmerz.</string>
    <string name="dm_assess_condition_lead">Allgemeinzustand</string>
    <string name="dm_assess_condition">Energie zurück, Gewicht stabil, kein Fieber.</string>
    <string name="dm_assess_mucosa">Mukosale Abheilung oder deutliche Besserung in der Endoskopie.</string>
    <string name="dm_assess_score_title">📝 Einfacher Aktivitäts-Score (Selbstbeurteilung)</string>
    <string name="dm_assess_score_intro">Wählen Sie anhand des Durchschnitts der letzten 3 Tage die am besten passende Option und tippen Sie auf den Button unten.</string>
