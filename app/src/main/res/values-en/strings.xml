    <!-- ==================== Daily care handbook ==================== -->
    <string name="dm_title">Daily Care Handbook</string>
    <string name="dm_subtitle">Evidence-based advice · Adjust flexibly to your disease stage\nDevelop an individualized plan together with your doctor</string>
    <string name="dm_disclaimer">📌 Important note\nThis information is for reference only and is not a substitute for professional medical advice.\nBe sure to work out your specific plan with your attending doctor.</string>
    <string name="dm_card_diet">Diet Management</string>
    <string name="dm_card_lifestyle">Lifestyle Management</string>
    <string name="dm_card_medical">Medication &amp; Medical Care</string>
    <string name="dm_card_psych">Mental Well-being</string>
    <string name="dm_card_assessment">Self-assessment · Symptom Checklist</string>
    <string name="dm_diet_core_principle">**Core principle:** adjust flexibly according to the **acute phase** or **remission phase** to “ease the load” on or “repair” your gut.</string>
    <string name="dm_diet_acute_title">🔴 Acute flare-up · Strictly reduce the load</string>
    <string name="dm_diet_acute_b1_lead">No residue, soft liquid/semi-liquid</string>
    <string name="dm_diet_acute_b1">Rice water, lotus root starch, steamed egg custard, well-cooked noodles, fat-free clear broth.</string>
    <string name="dm_diet_acute_b2_lead">Purpose</string>
    <string name="dm_diet_acute_b2">Reduce stool volume and frequency to let the gut rest.</string>
    <string name="dm_diet_remission_title">🟢 Remission · Gradual repair</string>
    <string name="dm_diet_remission_b1_lead">High nutrition, easy to digest, low residue</string>
    <string name="dm_diet_remission_b1">Steamed fish, egg custard, soft tofu, finely minced lean meat.</string>
    <string name="dm_diet_remission_b2">Supplement high-quality protein to repair the intestinal lining.</string>
    <string name="dm_diet_issues_title">⚠️ “Problem foods” to watch out for</string>
    <string name="dm_diet_fiber_lead">High fiber</string>
    <string name="dm_diet_fiber">(avoid during flare-ups): nuts, seeds, corn, popcorn, raw vegetables.</string>
    <string name="dm_diet_dairy_lead">Dairy products</string>
    <string name="dm_diet_dairy">Some patients cannot tolerate them; you may pause and observe.</string>
    <string name="dm_diet_drinks_lead">Stimulating drinks</string>
    <string name="dm_diet_drinks">Alcohol, caffeine, carbonated drinks.</string>
    <string name="dm_diet_greasy_lead">Greasy, spicy</string>
    <string name="dm_diet_greasy">Deep-fried, grilled, chili.</string>
    <string name="dm_diet_tips_title">💡 Practical tips</string>
    <string name="dm_diet_cooking_lead">Change how you cook</string>
    <string name="dm_diet_cooking">Steam, boil, roast or purée vegetables and fruit — cook them thoroughly.</string>
    <string name="dm_diet_soluble_fiber_lead">Soluble fiber</string>
    <string name="dm_diet_soluble_fiber">(when tolerated): oats, peeled sweet potato, banana, well-cooked carrot.</string>
    <string name="dm_diet_small_meals_lead">Small, frequent meals</string>
    <string name="dm_diet_small_meals">Five to six small meals a day reduce the load of each meal.</string>
    <string name="dm_diet_diary_lead">Food diary</string>
    <string name="dm_diet_diary">Record foods and reactions to precisely avoid “problem foods”.</string>
    <string name="dm_lifestyle_sleep_title">😴 Regular sleep</string>
    <string name="dm_lifestyle_sleep">Ensure **7~8 hours** of quality sleep every night and avoid overexertion to help keep your immune system stable.</string>
    <string name="dm_lifestyle_exercise_title">🚶 Moderate exercise</string>
    <string name="dm_lifestyle_exercise_acute_lead">Acute phase</string>
    <string name="dm_lifestyle_exercise_acute">Rest is the priority; avoid exercise.</string>
    <string name="dm_lifestyle_exercise_remission_lead">Remission phase</string>
    <string name="dm_lifestyle_exercise_remission">Gentle aerobic activity (walking, jogging, yoga, tai chi, swimming). Frequency: **3~5 times a week**, 20~60 minutes each, at a level that does not cause excessive fatigue afterwards.</string>
    <string name="dm_lifestyle_stress_title">🧘 Stress management</string>
    <string name="dm_lifestyle_stress">Mental stress can worsen symptoms; relieve it through **meditation, deep breathing, talking with family and friends, or patient support groups**.</string>
    <string name="dm_med_meds_title">💊 Take medication properly</string>
    <string name="dm_med_meds">**Strictly follow your doctor\'s instructions** — never stop, reduce or switch medication on your own. Common drugs include aminosalicylates, immunomodulators and biologics. Also, treat according to where the inflammation is located: for example, if the inflammation is in the rectum, suppositories can be more effective.</string>
    <string name="dm_med_pain_title">🚫 Use painkillers with caution</string>
    <string name="dm_med_pain">Avoid **nonsteroidal anti-inflammatory drugs (NSAIDs)** (e.g. ibuprofen, naproxen) — they may trigger a flare-up.</string>
    <string name="dm_med_nutrition_title">🧪 Supplement nutrients</string>
    <string name="dm_med_nutrition">Long-term diarrhea may cause nutrient loss; under your doctor\'s guidance you may supplement **iron, calcium and vitamin D**.</string>
    <string name="dm_med_checkup_title">📅 Regular follow-up</string>
    <string name="dm_med_checkup">If you have had the disease for **8~10 years** or more, it is recommended to undergo **colonoscopy every 1~2 years** to monitor the condition and screen for cancer risk.</string>
    <string name="dm_med_vaccine_title">💉 Vaccination</string>
    <string name="dm_med_vaccine">After consulting your doctor, get vaccinated on time with the **flu vaccine** and **pneumococcal vaccine** (the disease or its medication may affect your immune system).</string>
    <string name="dm_psych_p1">Recognizing that ulcerative colitis is a chronic condition and learning to live with it is very important. A positive mindset and a sound understanding of the disease are themselves a powerful “medicine”.</string>
    <string name="dm_psych_tip">**🌱 Suggestion:** if you feel anxious or depressed, do not hesitate to seek help from a **professional counselor** in time.</string>
    <string name="dm_psych_p2">Sharing your feelings with family, friends or fellow patients, and joining support groups, can help lighten the psychological burden.</string>
    <string name="dm_assess_intro">Use the typical symptom checklist and the simple score to get an initial sense of your current stage. ⚠️ This tool is not a substitute for professional diagnosis — if in doubt, see a doctor promptly.</string>
    <string name="dm_assess_active_title">🔄 Common signs during a flare-up (active phase)</string>
    <string name="dm_assess_diarrhea_lead">Diarrhea</string>
    <string name="dm_assess_diarrhea">Bowel frequency increases markedly (more than 3 times a day), often loose or watery.</string>
    <string name="dm_assess_blood_lead">Bloody stool</string>
    <string name="dm_assess_blood">Stool contains blood or mucus, which may coat the stool or be mixed with it, sometimes with clots or mucopurulent discharge.</string>
    <string name="dm_assess_blood_color_lead">Blood color reference</string>
    <string name="dm_assess_blood_color">Bright or dark red usually suggests disease in the rectum or sigmoid colon (near the anus), where blood passes quickly and is less oxidized; dark red or black (tarry) stool usually suggests a higher lesion, such as the transverse colon, ascending colon or even the terminal ileum, where blood stays longer in the gut and darkens after oxidation. Color is only one clue — never use it alone to diagnose yourself.</string>
    <string name="dm_assess_pain_lead">Abdominal pain</string>
    <string name="dm_assess_pain">Lower abdominal cramping or persistent dull pain, which may ease after a bowel movement.</string>
    <string name="dm_assess_urgency_lead">Tenesmus</string>
    <string name="dm_assess_urgency">Constant urge to defecate but with a feeling of incomplete evacuation.</string>
    <string name="dm_assess_systemic_lead">Systemic symptoms</string>
    <string name="dm_assess_systemic">Fever, fatigue, weight loss, poor appetite.</string>
    <string name="dm_assess_remission_title">🟢 Common signs in remission</string>
    <string name="dm_assess_normal_bowel_lead">Normal bowel movements</string>
    <string name="dm_assess_normal_bowel">1~2 formed stools a day, no blood.</string>
    <string name="dm_assess_no_pain_lead">Pain gone</string>
    <string name="dm_assess_no_pain">No abdominal discomfort, or only mild dull pain.</string>
    <string name="dm_assess_condition_lead">General condition</string>
    <string name="dm_assess_condition">Energy restored, weight stable, no fever.</string>
    <string name="dm_assess_mucosa">Mucosal healing or marked improvement on endoscopy.</string>
    <string name="dm_assess_score_title">📝 Simple activity score (self-assessment reference)</string>
    <string name="dm_assess_score_intro">Based on the average of the last 3 days, pick the option that fits best, then tap the button below to evaluate.</string>
