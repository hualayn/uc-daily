    <!-- ==================== Manual de cuidados diários ==================== -->
    <string name="dm_title">Manual de cuidados diários</string>
    <string name="dm_subtitle">Recomendações baseadas em evidências · Ajuste conforme a fase da doença\nElabore um plano personalizado com seu médico</string>
    <string name="dm_disclaimer">📌 Aviso importante\nEstas informações são apenas de referência e não substituem orientação médica profissional.\nO plano concreto deve sempre ser definido com seu médico.</string>
    <string name="dm_card_diet">Gestão da alimentação</string>
    <string name="dm_card_lifestyle">Estilo de vida</string>
    <string name="dm_card_medical">Medicação e cuidados médicos</string>
    <string name="dm_card_psych">Bem-estar psicológico</string>
    <string name="dm_card_assessment">Autoavaliação · Comparação de sintomas</string>
    <string name="dm_diet_core_principle">**Princípio central:** ajuste-se com flexibilidade à **fase aguda** ou à **fase de remissão** para « aliviar » ou « reparar » o intestino.</string>
    <string name="dm_diet_acute_title">🔴 Crise aguda · Reduzir muito a carga</string>
    <string name="dm_diet_acute_b1_lead">Sem resíduos, líquido/semilíquido macio</string>
    <string name="dm_diet_acute_b1">Água de arroz, fécula de lótus, creme de ovo no vapor, macarrão bem cozido, caldo claro sem gordura.</string>
    <string name="dm_diet_acute_b2_lead">Objetivo</string>
    <string name="dm_diet_acute_b2">Reduzir o volume e a frequência das fezes para o intestino descansar.</string>
    <string name="dm_diet_remission_title">🟢 Remissão · Reparação progressiva</string>
    <string name="dm_diet_remission_b1_lead">Rico em nutrientes, fácil de digerir, baixo resíduo</string>
    <string name="dm_diet_remission_b1">Peixe no vapor, creme de ovo, tofu macio, carne magra bem picada.</string>
    <string name="dm_diet_remission_b2">Fornecer proteínas de qualidade para reparar a mucosa intestinal.</string>
    <string name="dm_diet_issues_title">⚠️ « Alimentos-problema » aos quais prestar atenção</string>
    <string name="dm_diet_fiber_lead">Ricos em fibras</string>
    <string name="dm_diet_fiber">(evitar durante a crise): nozes, sementes, milho, pipoca, vegetais crus.</string>
    <string name="dm_diet_dairy_lead">Laticínios</string>
    <string name="dm_diet_dairy">Alguns pacientes não os toleram; você pode pausar e observar.</string>
    <string name="dm_diet_drinks_lead">Bebidas estimulantes</string>
    <string name="dm_diet_drinks">Álcool, cafeína, bebidas gaseificadas.</string>
    <string name="dm_diet_greasy_lead">Gorduroso, picante</string>
    <string name="dm_diet_greasy">Frituras, grelhados, pimenta.</string>
    <string name="dm_diet_tips_title">💡 Dicas práticas</string>
    <string name="dm_diet_cooking_lead">Mude o preparo</string>
    <string name="dm_diet_cooking">Cozinhe frutas e vegetais no vapor, fervidos, assados ou batidos, bem cozidos.</string>
    <string name="dm_diet_soluble_fiber_lead">Fibras solúveis</string>
    <string name="dm_diet_soluble_fiber">(se toleradas): aveia, batata-doce sem casca, banana, cenoura bem cozida.</string>
    <string name="dm_diet_small_meals_lead">Refeições pequenas e frequentes</string>
    <string name="dm_diet_small_meals">Cinco a seis refeições pequenas por dia reduzem a carga de cada uma.</string>
    <string name="dm_diet_diary_lead">Diário alimentar</string>
    <string name="dm_diet_diary">Registre alimentos e reações para evitar com precisão os « alimentos-problema ».</string>
    <string name="dm_lifestyle_sleep_title">😴 Sono regular</string>
    <string name="dm_lifestyle_sleep">Garanta **7~8 horas** de sono de qualidade todas as noites e evite excesso de trabalho para estabilizar o sistema imunológico.</string>
    <string name="dm_lifestyle_exercise_title">🚶 Exercício moderado</string>
    <string name="dm_lifestyle_exercise_acute_lead">Fase aguda</string>
    <string name="dm_lifestyle_exercise_acute">O descanso é prioridade; evite exercícios.</string>
    <string name="dm_lifestyle_exercise_remission_lead">Remissão</string>
    <string name="dm_lifestyle_exercise_remission">Aeróbico leve (caminhada, corrida leve, ioga, tai chi, natação). Frequência: **3~5 vezes por semana**, 20~60 minutos, sem cansaço excessivo depois.</string>
    <string name="dm_lifestyle_stress_title">🧘 Gestão do estresse</string>
    <string name="dm_lifestyle_stress">O estresse psicológico pode piorar os sintomas; alivie-o com **meditação, respiração profunda, conversas com familiares e amigos ou grupos de apoio**.</string>
    <string name="dm_med_meds_title">💊 Tomar os medicamentos corretamente</string>
    <string name="dm_med_meds">**Siga rigorosamente as orientações médicas** — nunca suspenda, reduza ou troque medicamentos por conta própria. Os medicamentos comuns incluem aminosalicilatos, imunomoduladores e biológicos. Trate também conforme o local da inflamação: por exemplo, se a inflamação estiver no reto, supositórios podem ser mais eficazes.</string>
    <string name="dm_med_pain_title">🚫 Analgésicos com cautela</string>
    <string name="dm_med_pain">Evite os **anti-inflamatórios não esteroides (AINEs)** (ex.: ibuprofeno, naproxeno); eles podem desencadear uma crise.</string>
    <string name="dm_med_nutrition_title">🧪 Suplementos nutricionais</string>
    <string name="dm_med_nutrition">A diarreia prolongada pode causar perdas nutricionais; sob orientação médica, suplemente **ferro, cálcio e vitamina D**.</string>
    <string name="dm_med_checkup_title">📅 Acompanhamento regular</string>
    <string name="dm_med_checkup">Se a doença dura **8~10 anos** ou mais, recomenda-se realizar **colonoscopia a cada 1~2 anos** para monitorar a doença e rastrear o risco de câncer.</string>
    <string name="dm_med_vaccine_title">💉 Vacinação</string>
    <string name="dm_med_vaccine">Após consultar seu médico, vacine-se na época certa contra **a gripe** e **o pneumococo** (a doença ou seus medicamentos podem afetar o sistema imunológico).</string>
    <string name="dm_psych_p1">Reconhecer que a retocolite ulcerativa é uma doença crônica e aprender a conviver com ela é muito importante. Uma atitude positiva e um bom entendimento da doença são por si só um poderoso « medicamento ».</string>
    <string name="dm_psych_tip">**🌱 Sugestão:** se você se sentir ansioso ou deprimido, não hesite em buscar a tempo a ajuda de um **profissional de saúde mental**.</string>
    <string name="dm_psych_p2">Compartilhar sentimentos com familiares, amigos ou outros pacientes e participar de grupos de apoio alivia o peso psicológico.</string>
    <string name="dm_assess_intro">Use a comparação de sintomas típicos e o escore simples para estimar sua fase atual. ⚠️ Esta ferramenta não substitui um diagnóstico profissional — em caso de dúvida, procure um médico logo.</string>
    <string name="dm_assess_active_title">🔄 Sinais frequentes na crise (fase ativa)</string>
    <string name="dm_assess_diarrhea_lead">Diarreia</string>
    <string name="dm_assess_diarrhea">Frequência de evacuações claramente aumentada (mais de 3 vezes ao dia), geralmente moles ou líquidas.</string>
    <string name="dm_assess_blood_lead">Sangue nas fezes</string>
    <string name="dm_assess_blood">Sangue ou muco nas fezes, na superfície ou misturado, às vezes com coágulos ou pus mucoso.</string>
    <string name="dm_assess_blood_color_lead">Cor do sangue: referência</string>
    <string name="dm_assess_blood_color">Sangue vermelho vivo ou vermelho-escuro costuma indicar comprometimento do reto ou do cólon sigmoide (perto do ânus), com eliminação rápida e menor oxidação; fezes vermelho-escuras ou pretas (alcatroadas) indicam lesão mais alta — cólon transverso, ascendente ou mesmo íleo terminal — onde o sangue permanece mais tempo no intestino e escurece após oxidação. A cor é apenas uma pista e nunca pode ser a única base para um diagnóstico.</string>
    <string name="dm_assess_pain_lead">Dor abdominal</string>
    <string name="dm_assess_pain">Cólicas no baixo ventre ou dor surda contínua, que pode melhorar após a evacuação.</string>
    <string name="dm_assess_urgency_lead">Tenesmo</string>
    <string name="dm_assess_urgency">Vontade constante de evacuar com sensação de esvaziamento incompleto.</string>
    <string name="dm_assess_systemic_lead">Sintomas sistêmicos</string>
    <string name="dm_assess_systemic">Febre, cansaço, perda de peso, falta de apetite.</string>
    <string name="dm_assess_remission_title">🟢 Sinais frequentes na remissão</string>
    <string name="dm_assess_normal_bowel_lead">Evacuações normais</string>
    <string name="dm_assess_normal_bowel">1~2 evacuações formadas por dia, sem sangue.</string>
    <string name="dm_assess_no_pain_lead">Dor desaparecida</string>
    <string name="dm_assess_no_pain">Sem desconforto abdominal ou apenas leve dor surda.</string>
    <string name="dm_assess_condition_lead">Estado geral</string>
    <string name="dm_assess_condition">Energia recuperada, peso estável, sem febre.</string>
    <string name="dm_assess_mucosa">Cicatrização da mucosa ou melhora clara na endoscopia.</string>
    <string name="dm_assess_score_title">📝 Escore de atividade simples (autoavaliação)</string>
    <string name="dm_assess_score_intro">Com base na média dos últimos 3 dias, escolha a opção mais adequada e toque no botão abaixo para avaliar.</string>
